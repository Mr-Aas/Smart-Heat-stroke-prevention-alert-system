# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Demo mode ----
# When true, the app runs fully on realistic simulated data and never calls
# paid/external services. When false (the default here), the app uses REAL
# live weather from Open-Meteo (free, no key needed) - see weatherService.js.
# Set to true only if you want to demo offline or without network access.
DEMO_MODE=false

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/smartheat-ai

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Weather source ----
# Live data comes from Open-Meteo (https://open-meteo.com), which is free and
# needs no API key, so weather works even before you fill in anything below.
# If you have an IMD (India Meteorological Department) data feed, put its
# base URL / key here and imdService.js will prefer it automatically.
IMD_API_BASE_URL=
IMD_API_KEY=

# ---- AI Advisory ----
# Optional. If set, aiService.js calls the Anthropic API for richer natural-
# language explanations. Without it, a rule-based advisory generator is used
# instead, so the feature still works with zero configuration.
ANTHROPIC_API_KEY=

# ---- WhatsApp Web Alert Client (whatsapp-web.js) ----
ENABLE_WHATSAPP=true
WHATSAPP_DEFAULT_COUNTRY_CODE=91
DEFAULT_ALERT_PHONE_NUMBER=

# ---- Notifications (Twilio) ----
# Optional. Without these, notificationService.js falls back to WhatsApp Web or simulated mode
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

CLIENT_URL=http://localhost:5173

